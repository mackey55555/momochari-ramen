# このファイルをコピーして .env.local を作り、値を埋めてください。
#   cp .env.example .env.local
# .env.local は Git にコミットされません（.gitignore 済み）。

# Supabase の URL と anon key。
# Supabase ダッシュボード > Project Settings > API から取得します。
# NEXT_PUBLIC_ で始まる変数はブラウザにも渡されます（＝公開されます）。
# anon key は公開前提のキーなのでこれで問題ありません。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IoT デバイスからの書き込み API（/api/ingest, /api/ramen）を守るための合言葉。
# NEXT_PUBLIC_ を付けないのでサーバー側でしか読めません。絶対に公開しないこと。
# 値は自由に決めてよいですが、推測されにくい長い文字列にしてください。
#   例: openssl rand -hex 24
DEVICE_API_KEY=
