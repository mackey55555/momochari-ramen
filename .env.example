# このファイルをコピーして .env.local を作り、値を埋めてください。
#   cp .env.example .env.local
# .env.local は Git にコミットされません（.gitignore 済み）。

# Supabase の URL と Publishable key。
# Supabase ダッシュボード > Project Settings > API Keys から取得します。
#   ・URL             … 「Project URL」の値
#   ・Publishable key … 「sb_publishable_」で始まる長い文字列
# NEXT_PUBLIC_ で始まる変数はブラウザにも渡されます（＝公開されます）。
# Publishable key は公開前提のキーなのでこれで問題ありません。
# （古い記事だと「anon key」という名前で出てきますが、同じ役割のものです）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# IoT デバイスからの書き込み API（/api/ingest, /api/ramen）を守るための合言葉。
# NEXT_PUBLIC_ を付けないのでサーバー側でしか読めません。絶対に公開しないこと。
# 値は自由に決めてよいですが、推測されにくい長い文字列にしてください。
#   例: openssl rand -hex 24
DEVICE_API_KEY=
