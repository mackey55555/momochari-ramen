# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example は「何を設定すればいいか」の見本なのでコミットする
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ラズパイ地図アプリ（iot/mapapp/）が生成・使用するもの
# 地図タイルは数十MB あるうえ OpenStreetMap から取り直せるので、リポジトリには入れない
/iot/mapapp/tiles/
/iot/mapapp/shops_cache.json
/iot/mapapp/_fake/
__pycache__/
*.pyc
